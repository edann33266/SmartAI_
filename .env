# --------------------------------------------
# AI/LLM Configuration (REQUIRED)
# --------------------------------------------

GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HER
GEMINI_MODEL=gemini-2.0-flash

# --------------------------------------------
# SMTP Email Configuration
# --------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_STARTTLS=true
SMTP_USE_AUTH=true
SMTP_USERNAME=PASTE_YOUR_EMAIL_HERE
SMTP_PASSWORD=PASTE_YOUR_NEW_APP_PASSWORD_HERE
SMTP_FROM_NAME=Sales AI
SMTP_FROM_EMAIL=PASTE_YOUR_EMAIL_HERE
TEST_EMAIL_TO=PASTE_EMAIL_HERE

# --------------------------------------------
# Dry Run Mode
# --------------------------------------------
# true  = prints email to console, nothing actually sent (safe for testing)
# false = sends a real email via SMTP
DRY_RUN=false

# --------------------------------------------
# Product Configuration
# --------------------------------------------
PRODUCT_NAME=SalesAI Copilot
PRODUCT_VALUE_PROP=helps sales teams automatically prioritize leads and draft highly personalized outreach, saving hours per week.

# --------------------------------------------
# Data file location
# --------------------------------------------
CUSTOMERS_CSV=data/customers.csv

# --------------------------------------------
# CORS — origins allowed to call this API locally
# --------------------------------------------
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
